DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-do-not-reuse-this-value
DJANGO_ALLOWED_HOSTS=111.230.11.5,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1

DB_ENGINE=mysql
DB_NAME=clover_blog
DB_USER=clover_blog
DB_PASSWORD=replace-with-a-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=your-account@example.com

PROTECTED_MEDIA_ROOT=/opt/clover-blog/protected_media
DJANGO_LOG_LEVEL=INFO
BLOG_LOG_LEVEL=INFO

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PEXELS_API_KEY=
HOMEPAGE_VISION_API_KEY=
HOMEPAGE_VISION_MODEL=gpt-4.1-mini
